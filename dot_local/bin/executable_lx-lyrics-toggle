#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Toggle the LX Music lyrics overlay window on niri.

The window is launched with app-id "lx-lyrics", which lx-lyrics.kdl turns into
a floating bottom bar. Pressing the bound key again closes it; if the window
was left on another workspace it is moved to the current one instead.
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys

APP_ID = "lx-lyrics"
WINDOW_TITLE = "LX Lyrics"


def niri_json(*args: str):
    result = subprocess.run(
        ["niri", "msg", "--json", *args], capture_output=True, text=True
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "niri msg failed")
    output = result.stdout.strip()
    return json.loads(output) if output else None


def niri_action(*args: str) -> None:
    result = subprocess.run(
        ["niri", "msg", "action", *args], capture_output=True, text=True
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "niri action failed")


def find_window(windows):
    for window in windows or []:
        if window.get("app_id") == APP_ID:
            return window
    return None


def focused_workspace(workspaces):
    for workspace in workspaces or []:
        if workspace.get("is_focused"):
            return workspace
    return None


def spawn_window() -> None:
    kitty = shutil.which("kitty")
    if kitty is None:
        raise RuntimeError("kitty not found")

    lxtui = shutil.which("lxtui")
    if lxtui is None:
        candidate = os.path.expanduser("~/.local/bin/lxtui")
        if os.path.exists(candidate):
            lxtui = candidate

    command = [
        kitty,
        "--app-id",
        APP_ID,
        "--title",
        WINDOW_TITLE,
    ]
    if lxtui is not None:
        command += [
            "--directory",
            os.path.expanduser("~"),
            lxtui,
            "--lyrics-only",
        ]
    else:
        directory = os.path.expanduser(
            os.environ.get("LX_LYRICS_DIR", "~/Github/lx-music")
        )
        command += [
            "--directory",
            directory,
            "uv",
            "run",
            "lxtui.py",
            "--lyrics-only",
        ]

    subprocess.Popen(
        command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def main() -> int:
    try:
        window = find_window(niri_json("windows"))
        workspace = focused_workspace(niri_json("workspaces"))
    except Exception as exc:  # noqa: BLE001 - show the error to the user
        print(f"lx-lyrics-toggle: {exc}", file=sys.stderr)
        return 1

    if workspace is None:
        print("lx-lyrics-toggle: no focused workspace", file=sys.stderr)
        return 1

    try:
        if window is None:
            spawn_window()
            return 0
        if window.get("workspace_id") == workspace.get("id"):
            niri_action("close-window", "--id", str(window["id"]))
            return 0
        if not window.get("is_floating"):
            niri_action("toggle-window-floating", "--id", str(window["id"]))
        niri_action(
            "move-window-to-workspace",
            "--window-id",
            str(window["id"]),
            "--focus",
            "false",
            str(workspace["idx"]),
        )
        niri_action("focus-window", "--id", str(window["id"]))
    except Exception as exc:  # noqa: BLE001
        print(f"lx-lyrics-toggle: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
