    "volume",
    "mute",
)

DEFAULTS = {
    "status": "stoped",
    "name": "",
    "singer": "",
    "albumName": "",
    "duration": 0.0,
    "progress": 0.0,
    "playbackRate": 1.0,
    "picUrl": "",
    "lyricLineText": "",
    "lyricLineAllText": "",
    "lyric": "",
    "tlyric": "",
    "rlyric": "",
    "collect": False,
    "volume": 100,
    "mute": False,
}

HELP_LINES = (
    "空格 播放/暂停   j/k 切歌   h/l 快退/快进   ↑/↓ 音量   m 静音",
    "J/K 歌词滚动   d/u 翻页   a 自动跟随   c 收藏   / 搜索   o 歌单",
    "r 重连   ? / F1 全部快捷键   q 退出",
)

# 常见歌单链接域名 -> LX Music 源
