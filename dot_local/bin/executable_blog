#!/bin/bash

BLOG_PATH="${HOME}/Github/blog"

usage() {
    cat <<EOF
用法: $(basename "$0") [选项]

启动本地博客开发服务器。

选项:
  -h, --help       显示此帮助信息
  -p, --path <路径> 指定博客根目录 (默认: ${BLOG_PATH})

示例:
  $(basename "$0")
  $(basename "$0") -p ~/my-blog
EOF
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "${1:-}" in
        -h | --help) usage ;;
        -p | --path)
            BLOG_PATH="$2"
            shift 2
            ;;
        *)
            echo "未知选项: $1" >&2
            usage
            ;;
    esac
done

pnpm -C "${BLOG_PATH}" dev
