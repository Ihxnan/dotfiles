#!/usr/bin/env bash
set -euo pipefail

{{- if eq .chezmoi.os "linux" }}

# ---------- 仓库：不存在才追加到 /etc/pacman.conf ----------
add_repo() {
  local name=$1
  shift
  if pacman-conf --repo-list 2>/dev/null | grep -qx "$name"; then
    echo "==> repo ${name} 已存在，跳过"
    return 0
  fi
  echo "==> 添加 repo ${name}"
  {
    echo
    echo "[${name}]"
    for server in "$@"; do printf 'Server = %s\n' "$server"; done
  } | sudo tee -a /etc/pacman.conf >/dev/null
}

# ---------- GPG key：缺了就 recv，然后无条件本地签名 ----------
# 无条件 lsign 是幂等的，也能修好「key 已存在但没被 lsign」的情况
ensure_key() {
  local fp=$1
  local short=${fp: -16}
  if pacman-key --list-keys "$fp" >/dev/null 2>&1; then
    echo "==> key ${short} 已存在"
  else
    echo "==> 导入 key ${short}"
    sudo pacman-key --recv-keys "$fp" --keyserver hkps://keyserver.ubuntu.com
  fi
  echo "==> 本地签名 key ${short}"
  sudo pacman-key --lsign-key "$fp" >/dev/null || echo "⚠ 本地签名 ${short} 失败"
}

add_repo archlinuxcn \
  'https://mirrors.ustc.edu.cn/archlinuxcn/$arch' \
  'https://mirrors.tuna.tsinghua.edu.cn/archlinuxcn/$arch' \
  'https://mirrors.hit.edu.cn/archlinuxcn/$arch' \
  'https://repo.huaweicloud.com/archlinuxcn/$arch'
add_repo shorin-arch \
  'https://repo.shorin.xyz/archlinux/$arch'

ensure_key 4B1DE545A801D4549BFD3FEF90CB3D62C13D4796  # farseerfc — archlinuxcn
ensure_key 8ED9ABE61CDBAABAC4B6A694C9218E60C13B4BA8  # shorinkiwata — shorin-arch

echo "==> 同步仓库数据库"
sudo pacman -Syu --noconfirm

echo "==> archlinuxcn keyring"
sudo pacman -S --needed --noconfirm archlinuxcn-keyring

{{ if .packages.arch.archlinuxcn }}
echo "==> archlinuxcn repo"
archlinuxcn_pkgs=(
{{- range .packages.arch.archlinuxcn }}
  {{ . | shellQuote }}
{{- end }}
)
sudo pacman -S --needed --noconfirm "${archlinuxcn_pkgs[@]}"
{{- end }}

{{ if .packages.arch.shorin }}
echo "==> shorin repo"
shorin_pkgs=(
{{- range .packages.arch.shorin }}
  {{ . | shellQuote }}
{{- end }}
)
sudo pacman -S --needed --noconfirm "${shorin_pkgs[@]}"
{{- end }}

echo "==> pacman"
pacman_pkgs=(
{{- range .packages.arch.pacman }}
  {{ . | shellQuote }}
{{- end }}
)
sudo pacman -S --needed --noconfirm "${pacman_pkgs[@]}"

{{ if .packages.arch.aur }}
echo "==> AUR"
if ! command -v paru >/dev/null 2>&1; then
  sudo pacman -S --needed --noconfirm base-devel
  tmp="$(mktemp -d)"
  git clone --depth=1 https://aur.archlinux.org/paru-bin.git "$tmp/paru-bin"
  ( cd "$tmp/paru-bin" && makepkg -si --noconfirm )
  rm -rf "$tmp"
fi
aur_pkgs=(
{{- range .packages.arch.aur }}
  {{ . | shellQuote }}
{{- end }}
)
paru -S --needed --noconfirm "${aur_pkgs[@]}"
{{- end }}

{{ range .packages.arch.system_services }}
echo "==> 启用系统服务 {{ . }}"
sudo systemctl enable --now {{ . }} || echo "⚠ 无法启用 {{ . }}"
{{- end }}

{{ range .packages.arch.user_services }}
echo "==> 启用用户服务 {{ . }}"
systemctl --user enable --now {{ . }} || echo "⚠ 无法启用 {{ . }}"
{{- end }}

{{ range .packages.arch.user_groups }}
if ! id -nG | tr ' ' '\n' | grep -qx '{{ . }}'; then
  echo "==> 将 $(id -un) 加入组 {{ . }}（重新登录后生效）"
  sudo usermod -aG '{{ . }}' "$(id -un)"
fi
{{- end }}

echo "==> packages done"
{{- end }}
