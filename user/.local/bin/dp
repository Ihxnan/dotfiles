# ── helpers ──────────────────────────────────────────────────

usage() {
    local me="$(basename "$0")"
    setup_i18n
    cat <<EOF
$(printf "$MSG_USAGE" "$me")

$MSG_TOOL_DESC

$MSG_OPTIONS_HEADER
EOF
    printf "  %-24s %s\n" \
        "-n, --max-attempts <num>" "$MSG_OPT_ATTEMPTS" \
        "-k, --keep-files"         "$MSG_OPT_KEEP" \
        "-d, --diff-flags <flags>" "$MSG_OPT_DIFF" \
        "-s, --std <standard>"     "$MSG_OPT_STD" \
        "-e, --eps <num>"          "$MSG_OPT_EPS" \
        "-c, --cmp <mode>"         "$MSG_OPT_CMP" \
        "-a, --ans <file>"         "$MSG_OPT_ANS" \
        "-t, --test <file>"        "$MSG_OPT_TEST" \
        "-g, --gen <file>"         "$MSG_OPT_GEN" \
        "-l, --lang <lang>"        "$MSG_OPT_LANG" \
        "--no-o3"                  "$MSG_OPT_NOO3" \
        "-h, --help"               "$MSG_OPT_HELP"

    cat <<EOF

$MSG_EXAMPLES
  $me
  $me -n 5000 -k

  # $MSG_EX_DIFF
EOF
    printf "  %-28s %s\n" \
        "$me -d \"-bB\""    "# $MSG_EX_WS_EDGES" \
        "$me -d \"-w\""     "# $MSG_EX_WS_ALL" \
        "$me -d \"-u -bB\"" "# $MSG_EX_COMBINE"
    cat <<EOF

  # $MSG_EX_OTHER
  $me -a brute.cpp -t solve.cpp -g gen.cpp
  $me -s c++20 --no-o3

  # $MSG_EX_FLOAT
EOF
    printf "  %-28s %s\n" \
        "$me -e 1e-4"   "# $MSG_EX_LOOSEN" \
        "$me -c strict" "# $MSG_EX_STRICT"
    cat <<EOF

$MSG_CMP_MODES
  auto    $MSG_CMP_AUTO
  strict  $MSG_CMP_STRICT
EOF
    exit 0
}

# Replace spaces with '.' for visually clear diff output
spaces_to_dots() { sed 's/ /./g'; }

write_diff_report() {
    local attempt=$1
    local cmp_detail=$2

    # Capture diff output once — reuse for preview and report
    local diff_out
    diff_out="$(diff "${DIFF_FLAGS[@]}" "$ANS_FILE" "$TEST_FILE" || true)"

    # ── header box ─────────────────────────────────────────────
    # Width is derived from the widest content line, measured in
    # terminal display columns (CJK text is 2 columns), so the box
    # stays aligned in both languages.
    local title="$(printf "$MSG_CE_FOUND_TITLE" "$attempt")"
    local t_line="$(printf '%s: %s' "$MSG_TIME" "$(date)")"
    local m_line="$(printf '%s: %s    %s: %s' "$MSG_MAX_ATTEMPTS" "$MAX_ATTEMPTS" "$MSG_KEEP_FILES" "$([ $KEEP_FILES -eq 1 ] && echo "$MSG_YES" || echo "$MSG_NO")")"
    local c_line="$(printf '%s: %s    %s: %s' "$MSG_CMP_MODE" "$CMP_MODE" "$MSG_EPS" "$EPS")"

    local max_w=0 w line
    for line in "$title" "$t_line" "$m_line" "$c_line"; do
        w="$(disp_width "$line")"
        ((w > max_w)) && max_w=$w
    done

    local content_w=$((max_w + 2))   # breathing room inside the walls
    local box_w=$((content_w + 4))   # "│ " + content + " │"
    local bar_body
    printf -v bar_body '%*s' $((box_w - 2)) ''
    bar_body="${bar_body// /─}"
    local box_bar="┌${bar_body}┐"
    local box_sep="├${bar_body}┤"
    local box_bot="└${bar_body}┘"
    local sep
    printf -v sep '%*s' "$box_w" ''
    sep="${sep// /─}"

    {
        echo "$box_bar"
        printf "│ %s │\n" "$(pad "$title" "$content_w")"
        echo "$box_sep"
        printf "│ %s │\n" "$(pad "$t_line" "$content_w")"
        printf "│ %s │\n" "$(pad "$m_line" "$content_w")"
        printf "│ %s │\n" "$(pad "$c_line" "$content_w")"
        echo "$box_bot"
        echo ""

        printf '%s (%s):\n' "$MSG_INPUT" "$DATA_FILE"
        echo "$sep"
        cat "$DATA_FILE"
        echo ""

        printf '%s (%s)  %s:\n' "$MSG_EXPECTED" "$ANS_FILE" "$MSG_SPACES_NOTE"
        echo "$sep"
        spaces_to_dots < "$ANS_FILE"
        echo ""

        printf '%s (%s)  %s:\n' "$MSG_GOT" "$TEST_FILE" "$MSG_SPACES_NOTE"
        echo "$sep"
        spaces_to_dots < "$TEST_FILE"
        echo ""

        printf '%s (%s):\n' "$MSG_DIFF" "${DIFF_FLAGS[*]}"
        echo "$sep"
        echo "$diff_out"
        echo ""

        if [[ -n "$cmp_detail" ]]; then
            echo "$MSG_COMPARATOR_REPORT"
            echo "$sep"
            echo "$cmp_detail"
            echo ""
        fi
    } > "$DIFF_CASE_FILE"

    # Also return diff text for preview
    echo "$diff_out"
}

cleanup() {
    echo ""
    echo "$MSG_INTERRUPT"
    rm -f ./*.out "$DATA_FILE" "$ANS_FILE" "$TEST_FILE"
    if [[ $KEEP_FILES -eq 0 ]] && [[ -f "$DIFF_CASE_FILE" ]]; then
        rm -f "$DIFF_CASE_FILE"
        echo "$MSG_ALL_TEMP_DELETED"
    elif [[ -f "$DIFF_CASE_FILE" ]]; then
        echo "$(printf "$MSG_DIFF_PRESERVED" "$DIFF_CASE_FILE")"
    else
        echo "$MSG_TEMP_DELETED"
    fi
    exit 1
}

# ── options ──────────────────────────────────────────────────

trap cleanup SIGINT

setup_i18n

while getopts "n:kd:a:t:g:s:e:c:hl:-:" opt; do
    case "$opt" in
    n) MAX_ATTEMPTS="$OPTARG" ;;
    e) EPS="$OPTARG" ;;
    c) CMP_MODE="$OPTARG" ;;
    k) KEEP_FILES=1 ;;
    d) read -ra DIFF_FLAGS <<< "$OPTARG" ;;
    s) CXX_STD="$OPTARG" ;;
    a) ANS_SRC="$OPTARG" ;;
    t) TEST_SRC="$OPTARG" ;;
    g) DATA_SRC="$OPTARG" ;;
    l) LANG_SETTING="$OPTARG"; setup_i18n ;;
    h) usage ;;
    -)
        case "${OPTARG}" in
        max-attempts) MAX_ATTEMPTS="${!OPTIND}"; OPTIND=$((OPTIND + 1)) ;;
        keep-files)   KEEP_FILES=1 ;;
        diff-flags)   read -ra DIFF_FLAGS <<< "${!OPTIND}"; OPTIND=$((OPTIND + 1)) ;;
        std)          CXX_STD="${!OPTIND}"; OPTIND=$((OPTIND + 1)) ;;
        ans)          ANS_SRC="${!OPTIND}"; OPTIND=$((OPTIND + 1)) ;;
        test)         TEST_SRC="${!OPTIND}"; OPTIND=$((OPTIND + 1)) ;;
        gen|data)     DATA_SRC="${!OPTIND}"; OPTIND=$((OPTIND + 1)) ;;
        no-o3)        USE_O3=0 ;;
        eps)          EPS="${!OPTIND}"; OPTIND=$((OPTIND + 1)) ;;
        cmp)          CMP_MODE="${!OPTIND}"; OPTIND=$((OPTIND + 1)) ;;
        lang)         LANG_SETTING="${!OPTIND}"; OPTIND=$((OPTIND + 1)); setup_i18n ;;
        help)         usage ;;
        *)            echo "$(printf "$MSG_ERR_UNKNOWN_LONG" "${OPTARG}")" >&2; usage ;;
        esac
        ;;
    \?) echo "$(printf "$MSG_ERR_UNKNOWN" "$OPTARG")" >&2; usage ;;
    :)  echo "$(printf "$MSG_ERR_REQUIRES" "$OPTARG")" >&2; usage ;;
    esac
done
shift $((OPTIND - 1))

case "$CMP_MODE" in
    auto|strict) ;;
    *) echo "$(printf "$MSG_ERR_CMP_MODE" "$CMP_MODE")" >&2; exit 1 ;;
esac

case "$LANG_SETTING" in
    en|zh) ;;
    *) echo "$(printf "$MSG_ERR_LANG" "$LANG_SETTING")" >&2; exit 1 ;;
esac

# ── compilation (parallel) ───────────────────────────────────

OPT_FLAGS=""
[[ $USE_O3 -eq 1 ]] && OPT_FLAGS="-O3"

CXXFLAGS="-std=$CXX_STD $OPT_FLAGS"
printf "$MSG_COMPILING\n" "$CXXFLAGS"

compile_one() {
    local src="$1" out="$2"
    if ! g++ $CXXFLAGS "$src" -o "$out"; then
        printf "${RED}  ✗ %s${RESET}\n" "$(printf "$MSG_COMPILE_FAIL" "$src")" >&2
        exit 1
    fi
}

compile_cmp() {
    # inline float comparator: compiled from stdin, no extra source file
    if ! g++ $CXXFLAGS -x c++ -o cmp.out - <<'CMP_EOF'
// Float-aware stress-test comparator: token-by-token
//  - if both tokens parse as numbers, compare with tolerance (|a-b| <= eps * max(1,|a|,|b|))
//  - otherwise compare strictly as strings
// usage: cmp.out <ans_file> <test_file> [eps]
#include <bits/stdc++.h>
using namespace std;

static double EPS = 1e-6;

static bool zh() {
    const char* l = getenv("DP_LANG");
    return l && strcmp(l, "zh") == 0;
}

static const char* m(const char* en, const char* zh_) {
    return zh() ? zh_ : en;
}

static bool isNum(const string& s) {
    if (s.empty()) return false;
    char* end = nullptr;
    strtod(s.c_str(), &end);
    return end == s.c_str() + s.size();
}

static double parse(const string& s) {
    return strtod(s.c_str(), nullptr);
}

static vector<pair<string, int>> readTokens(istream& in) {
    vector<pair<string, int>> v;
    string line;
    int lineNo = 0;
    while (getline(in, line)) {
        ++lineNo;
        istringstream ss(line);
        string t;
        while (ss >> t) v.emplace_back(t, lineNo);
    }
    return v;
}

int main(int argc, char** argv) {
    if (argc < 3) {
        fprintf(stderr, "%s\n",
                m("usage: cmp.out <ans_file> <test_file> [eps]",
                  "用法：cmp.out <ans_file> <test_file> [eps]"));
        return 2;
    }
    if (argc >= 4) EPS = atof(argv[3]);

    ifstream fa(argv[1]), fb(argv[2]);
    if (!fa.is_open() || !fb.is_open()) {
        fprintf(stderr, "%s\n", m("error: cannot open input files",
                                  "错误：无法打开输入文件"));
        return 2;
    }

    auto a = readTokens(fa);
    auto b = readTokens(fb);

    if (a.size() != b.size()) {
        cerr << m("token count mismatch: ", "token 数量不一致：")
             << "ans=" << a.size() << " test=" << b.size() << "\n";
        size_t n = min(a.size(), b.size()), i = 0;
        while (i < n && a[i].first == b[i].first) ++i;
        size_t lo = i >= 3 ? i - 3 : 0;
        size_t hi = min(n, i + 4);
        for (size_t j = lo; j < hi; ++j) {
            cerr << "  token " << (j + 1) << ": ans=\"" << a[j].first
                 << "\" test=\"" << b[j].first << "\"\n";
        }
        return 1;
    }

    for (size_t i = 0; i < a.size(); ++i) {
        const string& x = a[i].first;
        const string& y = b[i].first;
        if (isNum(x) && isNum(y)) {
            double dx = parse(x), dy = parse(y);
            if (isnan(dx) || isnan(dy)) {
                if (!(isnan(dx) && isnan(dy))) {
                    cerr << m("numeric mismatch (token ", "数值不一致（token ")
                         << (i + 1) << m(", line ", "，第 ")
                         << a[i].second << m("): ans=", " 行）：ans=")
                         << "\"" << x << "\" test=\"" << y << "\"\n";
                    return 1;
                }
            } else {
                double diff = fabs(dx - dy);
                double scale = max(1.0, max(fabs(dx), fabs(dy)));
                if (diff > EPS * scale) {
                    cerr << setprecision(10)
                         << m("numeric mismatch (token ", "数值不一致（token ")
                         << (i + 1) << m(", line ", "，第 ")
                         << a[i].second << m("):\n", " 行）：\n")
                         << "  ans=\"" << x << "\"\n"
                         << "  test=\"" << y << "\"\n"
                         << "  " << m("abs error=", "绝对误差=") << diff
                         << " " << m("rel error=", "相对误差=") << (diff / scale)
                         << m(" > eps=", " > 阈值=") << EPS << "\n";
                    return 1;
                }
            }
        } else if (x != y) {
            cerr << m("content mismatch (token ", "内容不一致（token ")
                 << (i + 1) << m(", ans line ", "，ans 第 ")
                 << a[i].second << m(", test line ", " 行，test 第 ")
                 << b[i].second << m("):\n", " 行）：\n")
                 << "  ans=\"" << x << "\"\n"
                 << "  test=\"" << y << "\"\n";
            return 1;
        }
    }
    return 0;
}
CMP_EOF
    then
        printf "${RED}  ✗ %s${RESET}\n" "$MSG_COMPILE_FAIL_CMP" >&2
        exit 1
    fi
}

compile_one "$DATA_SRC" data.out &
compile_one "$ANS_SRC"  ans.out &
compile_one "$TEST_SRC" test.out &
[[ $CMP_MODE != "strict" ]] && compile_cmp &
wait

printf "  ${GREEN}✔ %s${RESET}\n" "$MSG_COMPILE_OK"
echo ""

# ── test loop ────────────────────────────────────────────────

# ── progress bar ─────────────────────────────────────────────

BAR_WIDTH=24

draw_bar() {
    local current=$1 total=$2
    local pct filled

    (( total > 0 )) || total=1
    pct=$(( current * 100 / total ))
    filled=$(( current * BAR_WIDTH / total ))

    printf -v bar '%*s' "$filled" ''
    bar="${bar// /█}"
    printf -v bar '%s%*s' "$bar" $(( BAR_WIDTH - filled )) ''
    bar="${bar// /░}"

    printf "\033[2K\r  ${CYAN}%s${RESET}  [${CYAN}%s${RESET}]  %3d/%-3d  (%3d%%)" "$MSG_RUN" "$bar" "$current" "$total" "$pct"
}

# ── test loop ────────────────────────────────────────────────

line="M=$MAX_ATTEMPTS  K=$([ $KEEP_FILES -eq 1 ] && echo 'Y' || echo 'N')  O=${OPT_FLAGS:-(none)}  F=${DIFF_FLAGS[*]}"
box_line "$CYAN" "" "$line"
printf "  ${YELLOW}%s${RESET}\n" "$MSG_PRESS_CTRL_C"
echo ""

count=0
found=0

while ((count < MAX_ATTEMPTS)); do
    ((++count))

    # generate
    if ! ./data.out > "$DATA_FILE"; then
        printf "${RED}\n  ✗ %s${RESET}\n" "$(printf "$MSG_CRASHED" "data.out")"; exit 1
    fi

    # reference & target run in sequence (need data.txt for both)
    if ! ./ans.out < "$DATA_FILE" > "$ANS_FILE"; then
        printf "${RED}\n  ✗ %s${RESET}\n" "$(printf "$MSG_CRASHED" "ans.out")"; exit 1
    fi
    if ! ./test.out < "$DATA_FILE" > "$TEST_FILE"; then
        printf "${RED}\n  ✗ %s${RESET}\n" "$(printf "$MSG_CRASHED" "test.out")"; exit 1
    fi

    # compare: auto mode uses the float comparator, strict mode uses byte-level cmp
    cmp_detail=""
    if [[ $CMP_MODE == "strict" ]]; then
        if ! cmp -s "$ANS_FILE" "$TEST_FILE"; then
            found=1
        fi
    else
        if ! cmp_detail="$(DP_LANG="$LANG_SETTING" ./cmp.out "$ANS_FILE" "$TEST_FILE" "$EPS" 2>&1)"; then
            found=1
        fi
    fi

    if ((found)); then
        echo ""
        echo ""
        box_line "$RED" "$BOLD" "$(printf "$MSG_CE_FOUND")  $(printf "$MSG_ATTEMPT" "$count")"
        echo ""

        if [[ -n "$cmp_detail" ]]; then
            echo "$MSG_COMPARATOR_REPORT"
            echo "─────────────────────────────────────────────────────────"
            echo "$cmp_detail"
            echo ""
        fi

        # single diff call — captured into variable
        diff_text="$(write_diff_report "$count" "$cmp_detail")"
        echo "$(printf "$MSG_DIFF_PREVIEW" "${DIFF_FLAGS[*]}")"
        echo "─────────────────────────────────────────────────────────"
        head -20 <<< "$diff_text"
        if [[ $(wc -l <<< "$diff_text") -gt 20 ]]; then
            echo "  $(printf "$MSG_FULL_REPORT" "$DIFF_CASE_FILE")"
        fi
        echo "─────────────────────────────────────────────────────────"
        break
    fi

    draw_bar "$count" "$MAX_ATTEMPTS"
done

# newline after the progress bar
echo ""

# ── teardown ─────────────────────────────────────────────────

rm -f ./*.out "$DATA_FILE" "$ANS_FILE" "$TEST_FILE"

if ((found)); then
    if [[ $KEEP_FILES -eq 0 ]]; then
        rm -f "$DIFF_CASE_FILE"
        echo ""
        echo "$MSG_TEMP_CLEANED"
        echo "$MSG_USE_KEEP"
    else
        echo ""
        echo "$(printf "$MSG_DIFF_REPORT" "$DIFF_CASE_FILE")"
        clear
        cat "$DIFF_CASE_FILE"
    fi
else
    echo ""
    text="$(printf "$MSG_ALL_PASSED" "$MAX_ATTEMPTS")"
    box_line "$GREEN" "" "$text"
fi
