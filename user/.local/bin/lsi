#!/bin/bash
# 描述： 在终端预览图片 (chafa版)

CFG_GRID=4
CFG_PROTOCOL="k"
CFG_FRAMES=1
CFG_TITLE="%b"

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/lsi/config"

if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
fi

show_help() {
    echo "Usage: lsi [OPTIONS] [FILE/DIR...]"
    echo ""
    echo "Options:"
    echo "  -g, --grid N      Set grid size (current: $CFG_GRID)"
    echo "  -f, --frames N    Set GIF frames (current: $CFG_FRAMES)"
    echo "  -p, --protocol P  Set protocol [k/i/s] (current: $CFG_PROTOCOL)"
    echo "  --init            Generate default config file at ~/.config/lsi/config"
    echo "  -h, --help        Show this help"
}

init_config() {
    if [ -f "$CONFIG_FILE" ]; then
        echo "Config file already exists: $CONFIG_FILE"
        exit 1
    fi
    mkdir -p "$(dirname "$CONFIG_FILE")"
    cat <<EOF > "$CONFIG_FILE"
CFG_GRID=5
CFG_PROTOCOL="k"
CFG_FRAMES=1
CFG_TITLE="%b"
EOF
    echo "Config generated at: $CONFIG_FILE"
    exit 0
}

EZA_ARGS=()
TARGET_FILES=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) show_help; exit 0 ;;
        --init) init_config ;;
        -g|--grid)
            if [[ -n "$2" && "$2" =~ ^[0-9]+$ ]]; then CFG_GRID="$2"; shift 2
            else echo "Error: --grid requires a number."; exit 1; fi ;;
        -*) EZA_ARGS+=("$1"); shift ;;
        *) TARGET_FILES+=("$1"); shift ;;
    esac
done

[ ${#TARGET_FILES[@]} -eq 0 ] && TARGET_FILES=(".")

eza --icons=always "${EZA_ARGS[@]}" "${TARGET_FILES[@]}"

IMAGES_TO_SHOW=()
MODE="GRID"

if [ ${#TARGET_FILES[@]} -eq 1 ]; then
    TARGET="${TARGET_FILES[0]}"
    if [ -f "$TARGET" ] && [[ "$TARGET" =~ \.(jpg|jpeg|png|gif|webp|bmp)$ ]]; then
        IMAGES_TO_SHOW+=("$TARGET")
        MODE="SINGLE"
    elif [ -d "$TARGET" ]; then
        shopt -s nullglob
        IMAGES_TO_SHOW=("${TARGET}"/*.{jpg,jpeg,png,gif,webp,bmp})
        shopt -u nullglob
    fi
else
    for f in "${TARGET_FILES[@]}"; do
        if [[ -f "$f" && "$f" =~ \.(jpg|jpeg|png|gif|webp|bmp)$ ]]; then
            IMAGES_TO_SHOW+=("$f")
        fi
    done
fi

if [ ${#IMAGES_TO_SHOW[@]} -gt 0 ]; then
    echo ""
    if [ "$MODE" == "SINGLE" ]; then
        chafa --center=on --title="${IMAGES_TO_SHOW[0]##*/}" "${IMAGES_TO_SHOW[0]}"
    else
        echo -e "\033[0;36m--- 󰋩 Gallery Preview (${#IMAGES_TO_SHOW[@]} images) ---\033[0m"
        COLS=$(tput cols 2>/dev/null || echo 80)
        LINES=$(tput lines 2>/dev/null || echo 24)
        GRID_COLS="$CFG_GRID"
        TOTAL=${#IMAGES_TO_SHOW[@]}
        ROWS=$(( (TOTAL + GRID_COLS - 1) / GRID_COLS ))
        VIEW_H=$((ROWS + 1))
        chafa --view-size="${COLS}x${VIEW_H}" --grid="$GRID_COLS" --center=on --scale=max "${IMAGES_TO_SHOW[@]}"
    fi
fi
