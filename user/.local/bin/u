#!/usr/bin/env bash
#
# u — 存储设备挂载管理（CLI + fzf 仪表盘）
#   无参数运行且处于交互终端时打开菜单（仿 vir 的 fzf TUI）；
#   非交互环境（管道/脚本）下保持 toggle 行为。
#
# 默认设备 /dev/sda1 <-> 挂载点 /mnt，可用环境变量 U_DEVICE / U_MOUNT_POINT 覆盖。
#
# TUI 快捷键:
#   ↵    挂载/卸载选中的设备
#   S    强制卸载（busy 时延迟卸载 umount -l）
#   o    打开文件管理器（未挂载则先挂载）
#   ctrl-r 刷新列表      /  过滤      q/esc 退出

# ==================== 默认配置 ====================
DEVICE="${U_DEVICE:-/dev/sda1}"
MOUNT_POINT="${U_MOUNT_POINT:-/mnt}"
FORCE=0
ACTION=auto

# ==================== 输出（带可选颜色） ====================
if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-}" != dumb ]]; then
    _B=$'\e[1m'; _G=$'\e[32m'; _Y=$'\e[33m'; _R=$'\e[31m'; _C=$'\e[36m'; _N=$'\e[0m'
else
    _B=; _G=; _Y=; _R=; _C=; _N=
fi
msg()  { printf '%s%s%s\n' "${_C}${_B}" "$*" "${_N}"; }
ok()   { printf '%s%s%s\n' "${_G}" "$*" "${_N}"; }
warn() { printf '%s%s%s\n' "${_Y}" "$*" "${_N}"; }
err()  { printf '%s%s%s\n' "${_R}" "$*" "${_N}" >&2; }
die()  { err "$*"; exit 1; }

MENU_FOOTER='↵ 挂载/卸载   S 强制卸载   o 打开文件管理器   ctrl-r 刷新   / 过滤   q 退出'

# ==================== 帮助 ====================
usage() {
    cat <<EOF
用法: $(basename "$0") [动作] [选项]

挂载/卸载管理工具（默认设备 ${DEVICE} ↔ 挂载点 ${MOUNT_POINT}）。
无动作且处于交互终端时打开可视化菜单；非交互时等价于 toggle。

动作:
  menu, ui, tui        打开 fzf 菜单界面（设备列表）
  toggle               已挂载则卸载，未挂载则挂载（默认非交互行为）
  on, mount            确保设备已挂载到 ${MOUNT_POINT}
  off, umount, unmount 卸载设备（可安全拔出）
  status               查看设备与挂载点状态
  help                 显示本帮助

选项:
  -d, --device <设备>   指定设备，如 /dev/sdb1、LABEL=xxx、UUID=xxx
  -m, --mount <挂载点>  指定挂载点目录
  -f, --force           卸载被占用时改用延迟卸载 umount -l
  -h, --help            显示本帮助

环境变量: U_DEVICE、U_MOUNT_POINT 可设置默认设备与挂载点。

示例:
  $(basename "$0")                  # 交互终端: 打开菜单; 其他: 切换挂载
  $(basename "$0") menu             # 打开菜单
  $(basename "$0") status           # 查看状态
  $(basename "$0") -d /dev/sdb1 -m /media/data on
EOF
    exit 0
}

# ==================== 基础工具 ====================
sudo_run() { # 已为 root 时直接执行，否则经 sudo
    if (( EUID == 0 )); then "$@"; else sudo "$@"; fi
}

# 把 LABEL=/UUID= 等写法解析为实际设备节点（解析失败返回空）
resolve_path() {
    case "$DEVICE" in
        UUID=*)  blkid -U "${DEVICE#UUID=}" 2>/dev/null ;;
        LABEL=*) blkid -L "${DEVICE#LABEL=}" 2>/dev/null ;;
        *)       echo "$DEVICE" ;;
    esac
}

device_present() {
    local real
    real=$(resolve_path)
    [[ -n "$real" && -b "$real" ]]
}

# MOUNT_POINT 本身是挂载点时输出其源设备，否则输出为空
mountpoint_source() {
    mountpoint -q -- "$MOUNT_POINT" 2>/dev/null || return 1
    findmnt -rn -o SOURCE "$MOUNT_POINT" 2>/dev/null
}

# 设备当前挂载的全部挂载点（含“设备节点已消失但仍挂载”的兜底，去重）
device_targets() {
    local -a ts=()
    local t src
    while IFS= read -r t; do
        [[ -n "$t" ]] && ts+=("$t")
    done < <(findmnt -rn -o TARGET -S "$DEVICE" 2>/dev/null)
    src=$(mountpoint_source)
    if [[ -n "$src" && "$src" == "$DEVICE" ]]; then
        ts+=("$MOUNT_POINT")
    fi
    (( ${#ts[@]} > 0 )) || return 0
    printf '%s\n' "${ts[@]}" | sort -u
}

_device_mounted() {
    [[ -n "$(device_targets)" ]]
}

_notify() { # 桌面通知（fzf 内部操作无终端输出时反馈错误用）
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -a u "$1" "${2:-}" >/dev/null 2>&1 || true
}

# ==================== 挂载 ====================
wait_for_device() { # 设备未出现时短暂轮询（如刚插入的 USB）
    local tries=10
    while ! device_present; do
        if (( tries-- <= 0 )); then
            err "设备 $DEVICE 未找到（已等待约 5 秒），请确认已连接/插入后重试"
            exit 1
        fi
        (( tries == 9 )) && warn "设备 $DEVICE 不存在，等待其出现..."
        sleep 0.5
    done
}

mount_it() {
    local src t
    # 1) 挂载点已被其他设备占用 → 拒绝，避免误卸载无关设备
    src=$(mountpoint_source)
    if [[ -n "$src" ]]; then
        if [[ "$src" == "$DEVICE" ]]; then
            ok "设备已挂载到 $MOUNT_POINT，无需操作"
            return 0
        fi
        die "错误: $MOUNT_POINT 已被其他设备占用: $src（请先手动卸载）"
    fi
    # 2) 设备挂载在其他位置 → 先卸载，再挂载到目标点
    t=$(device_targets)
    if [[ -n "$t" ]]; then
        warn "设备当前挂载于 $(echo "$t" | tr '\n' ' ')，先卸载再挂载到 $MOUNT_POINT"
        unmount_device || die "切换挂载点失败"
    fi
    # 3) 等待设备出现
    wait_for_device
    # 4) 准备挂载点
    if [[ -e "$MOUNT_POINT" && ! -d "$MOUNT_POINT" ]]; then
        die "错误: $MOUNT_POINT 已存在但不是目录，无法作为挂载点"
    fi
    if [[ ! -d "$MOUNT_POINT" ]]; then
        msg "创建挂载点目录 $MOUNT_POINT ..."
        sudo_run mkdir -p "$MOUNT_POINT" || die "创建挂载点失败: $MOUNT_POINT"
    fi
    # 5) 执行挂载
    msg "挂载 $DEVICE → $MOUNT_POINT ..."
    if ! sudo_run mount "$DEVICE" "$MOUNT_POINT"; then
        err "挂载失败，可能原因：文件系统损坏、缺少驱动(exfat/ntfs-3g 等)、$MOUNT_POINT 被占用"
        return 1
    fi
    ok "挂载成功: $DEVICE → $MOUNT_POINT"
    local fstype size used avail
    read -r fstype size used avail \
        < <(findmnt -h -no FSTYPE,SIZE,USED,AVAIL "$MOUNT_POINT" 2>/dev/null)
    if [[ -n "$fstype" ]]; then
        msg "  文件系统: ${fstype:-?}  容量: ${size:-?}  已用: ${used:-?}  可用: ${avail:-?}"
    fi
    return 0
}

# ==================== 卸载 ====================
show_blockers() {
    local target=$1
    if command -v fuser >/dev/null 2>&1; then
        sudo_run fuser -vm "$target" 2>&1 | head -n 25 || true
    elif command -v lsof >/dev/null 2>&1; then
        sudo_run lsof "$target" 2>&1 | head -n 25 || true
    fi
    warn "提示: 请先关闭占用 $target 的程序（或退出该目录）再卸载；也可用 -f 延迟卸载"
}

unmount_targets() { # 卸载设备的所有挂载点，返回 0/1
    local targets t failed=0
    targets=$(device_targets)
    [[ -n "$targets" ]] || return 0
    sync
    while IFS= read -r t; do
        [[ -n "$t" ]] || continue
        msg "卸载 $t ..."
        if sudo_run umount "$t"; then
            ok "卸载成功: $t"
            continue
        fi
        if (( FORCE )); then
            warn "$t 被占用，改用延迟卸载 (umount -l)..."
            if sudo_run umount -l "$t"; then
                ok "已延迟卸载: $t"
                continue
            fi
            err "延迟卸载失败: $t"
        else
            err "卸载失败: $t 被占用"
            show_blockers "$t"
        fi
        failed=1
    done <<<"$targets"
    return "$failed"
}

unmount_device() {
    local targets
    targets=$(device_targets)
    if [[ -z "$targets" ]]; then
        warn "设备 $DEVICE 当前未挂载，无需卸载"
        return 0
    fi
    unmount_targets
    if (( $? == 0 )); then
        ok "已全部卸载，可以安全拔出"
    fi
    return $?
}

# ==================== 状态 ====================
status() {
    local real line src targets t
    real=$(resolve_path)
    msg "设备:   $DEVICE${real:+ -> $real}"
    msg "挂载点: $MOUNT_POINT"
    if ! device_present; then
        warn "设备不存在或未连接"
    else
        line=$(lsblk -no NAME,SIZE,FSTYPE,LABEL "$real" 2>/dev/null | head -n 1)
        [[ -n "$line" ]] && msg "信息:   $line"
    fi
    targets=$(device_targets)
    if [[ -z "$targets" ]]; then
        warn "未挂载"
    else
        while IFS= read -r t; do
            [[ -n "$t" ]] || continue
            ok "已挂载: $t"
            findmnt -h -no 'SOURCE,FSTYPE,SIZE,USED,AVAIL' "$t" 2>/dev/null | sed 's/^/        /'
        done <<<"$targets"
    fi
    src=$(mountpoint_source)
    if [[ -n "$src" && "$src" != "$DEVICE" ]]; then
        warn "$MOUNT_POINT 被其他设备占用: $src"
    fi
}

# ==================== TUI: 内部回调处理函数 ====================
# （这些函数只被 fzf 以 "$SCRIPT_PATH _internal_xxx {1}" 方式调用，
#   因此必须定义在本文件“路由”之前。）

# 行格式: 排序键|设备路径|状态|展示列（含 ANSI），路由前先排序再去掉键
_menu_row() {
    local p=$1 key state target name fs size label src
    name=${p##*/}
    target=$(findmnt -rn -o TARGET -S "$p" 2>/dev/null | head -n1)
    if [[ -z "$target" ]]; then
        src=$(mountpoint_source)
        [[ "$src" == "$p" ]] && target=$MOUNT_POINT
    fi
    fs=$(lsblk -no FSTYPE "$p" 2>/dev/null | head -n1); [[ -z "$fs" ]] && fs='-'
    size=$(lsblk -no SIZE "$p" 2>/dev/null | head -n1)
    label=$(lsblk -no LABEL "$p" 2>/dev/null | head -n1); [[ -z "$label" ]] && label='-'
    if [[ -n "$target" ]]; then
        key=1; state=mounted
        display=$(printf '  \e[1;32m%-8s\e[0m \e[37m%-8s\e[0m \e[37m%-7s\e[0m %-12s \e[1;36m→ %s\e[0m' "$name" "$size" "$fs" "$label" "$target")
    else
        key=2; state=unmounted
        display=$(printf '  \e[90m%-8s %-8s %-7s %-12s %s\e[0m' "$name" "$size" "$fs" "$label" '未挂载')
    fi
    printf '%d|%s|%s|%s\n' "$key" "$p" "$state" "$display"
}

cmd_internal_list() {
    local path type rm extra mp_src
    mp_src=$(mountpoint_source)
    local -a paths=()
    # 可移动分区 / crypt 设备（lsblk RM=1；PATH/TYPE/RM 均为空格分隔、不含空格）
    while read -r path type rm; do
        [[ -n "$path" && "$rm" == "1" ]] || continue
        case "$type" in
            part | crypt) paths+=("$path") ;;
        esac
    done < <(lsblk -rno PATH,TYPE,RM 2>/dev/null)
    # 始终把默认设备与“正占用挂载点的设备”列出来（无论是否可移动）
    for extra in "$DEVICE" "$mp_src"; do
        [[ -n "$extra" && -b "$extra" ]] && paths+=("$extra")
    done
    if (( ${#paths[@]} > 0 )); then
        printf '%s\n' "${paths[@]}" | sort -u | while IFS= read -r path; do
            [[ -n "$path" ]] && _menu_row "$path"
        done | sort -n -t'|' -k1,1 | cut -d'|' -f2-
    fi
}

cmd_internal_preview() {
    local p=${1:-} name fs size label tgt src sz uu av
    printf '%s\n' "$MENU_FOOTER"
    [[ -z "$p" ]] && return 0
    name=${p##*/}
    tgt=$(findmnt -rn -o TARGET -S "$p" 2>/dev/null | head -n1)
    if [[ -z "$tgt" ]]; then
        src=$(mountpoint_source)
        [[ "$src" == "$p" ]] && tgt=$MOUNT_POINT
    fi
    fs=$(lsblk -no FSTYPE "$p" 2>/dev/null | head -n1); [[ -z "$fs" ]] && fs='-'
    size=$(lsblk -no SIZE "$p" 2>/dev/null | head -n1)
    label=$(lsblk -no LABEL "$p" 2>/dev/null | head -n1); [[ -z "$label" ]] && label='-'
    printf '  \e[1;33m%s\e[0m   %s   文件系统: %s   标签: %s\n' "$name" "$size" "$fs" "$label"
    if [[ -n "$tgt" ]]; then
        read -r sz uu av <<<"$(findmnt -h -no SIZE,USED,AVAIL "$tgt" 2>/dev/null)"
        printf '  已挂载于 \e[1;36m%s\e[0m   容量 %s  已用 %s  可用 %s\n' "$tgt" "${sz:-?}" "${uu:-?}" "${av:-?}"
        printf '  ↵ 卸载 | o 在文件管理器中打开\n'
    else
        printf '  未挂载 —— ↵ 挂载到 %s | o 挂载并打开\n' "$MOUNT_POINT"
    fi
}

cmd_internal_toggle() {
    local p=${1:-} rc=0 what
    [[ -n "$p" ]] || exit 0
    DEVICE=$p
    if _device_mounted; then
        what=卸载
        ( unmount_device )
    else
        what=挂载
        ( mount_it )
    fi
    rc=$?
    if (( rc != 0 )); then
        _notify "u: $what失败" "$p —— 目标被占用或 sudo 凭据过期时，可回到菜单按 S 强制卸载"
    fi
    exit 0
}

cmd_internal_force() {
    local p=${1:-} tgt failed=0
    [[ -n "$p" ]] || exit 0
    DEVICE=$p
    sync
    while IFS= read -r tgt; do
        [[ -n "$tgt" ]] || continue
        sudo_run umount "$tgt" 2>/dev/null || sudo_run umount -l "$tgt" 2>/dev/null || failed=1
    done <<<"$(device_targets)"
    if (( failed )) || _device_mounted; then
        _notify 'u: 强制卸载失败' "仍处于挂载状态: $p"
    fi
    exit 0
}

cmd_internal_open() {
    local p=${1:-} tgt rc=0
    [[ -n "$p" ]] || exit 0
    DEVICE=$p
    tgt=$(device_targets | head -n1)
    if [[ -z "$tgt" ]]; then
        ( mount_it )
        rc=$?
        if (( rc != 0 )); then
            _notify 'u: 挂载失败' "无法挂载 $p 后打开"
            exit 0
        fi
        tgt=$MOUNT_POINT
    fi
    if command -v xdg-open >/dev/null 2>&1 && [[ -d "$tgt" ]]; then
        setsid xdg-open "$tgt" >/dev/null 2>&1 &
    fi
    exit 0
}

# ==================== TUI: 路由（fzf 回调入口） ====================
if [[ "${1:-}" == _internal_* ]]; then
    case "$1" in
        _internal_list)    cmd_internal_list ;;
        _internal_preview) cmd_internal_preview "${2:-}" ;;
        _internal_toggle)  cmd_internal_toggle "${2:-}" ;;
        _internal_force)   cmd_internal_force "${2:-}" ;;
        _internal_open)    cmd_internal_open "${2:-}" ;;
    esac
    exit $?
fi

# ==================== 菜单界面 ====================
menu() {
    for c in fzf awk cut sort realpath; do
        command -v "$c" >/dev/null 2>&1 || die "菜单模式需要命令: $c"
    done
    SCRIPT_PATH=$(realpath "$0")
    # 让 fzf 回调子进程继承解析后的配置
    export U_DEVICE="$DEVICE" U_MOUNT_POINT="$MOUNT_POINT"
    # 预先缓存 sudo 凭据，避免在 fzf 界面内弹密码
    if (( EUID != 0 )) && ! sudo -n true 2>/dev/null; then
        printf '%s\n' "挂载/卸载需要 root —— 请输入密码（本次会话授权）..."
        sudo -v || warn 'sudo 认证未通过：仍可浏览列表，但操作可能失败；建议改用: sudo u'
    fi
    export FZF_DEFAULT_COMMAND="$SCRIPT_PATH _internal_list"
    fzf --ansi \
        --layout=reverse \
        --info=hidden \
        --prompt='  ' \
        --border=rounded \
        --border-label=" Storage ↔ $MOUNT_POINT " \
        --border-label-pos=3 \
        --delimiter='\|' \
        --with-nth=3 \
        --bind 'j:down,k:up' \
        --bind 'space:disable-search' \
        --bind 'q:abort,esc:abort' \
        --bind "enter:execute-silent($SCRIPT_PATH _internal_toggle {1})+reload($SCRIPT_PATH _internal_list)" \
        --bind "S:execute-silent($SCRIPT_PATH _internal_force {1})+reload($SCRIPT_PATH _internal_list)" \
        --bind "o:execute-silent($SCRIPT_PATH _internal_open {1})" \
        --bind "ctrl-r:reload($SCRIPT_PATH _internal_list)" \
        --preview="$SCRIPT_PATH _internal_preview {1}" \
        --preview-window='bottom,6,border-top'
}

# ==================== 动作 ====================
toggle() {
    if _device_mounted; then
        unmount_device
    else
        mount_it
    fi
}

# ==================== 参数解析 ====================
parse_args() {
    local -a args=("$@")
    local i=0 verb_seen=0 a
    while (( i < ${#args[@]} )); do
        a=${args[i]}
        case "$a" in
            -h | --help | help) usage ;;
            -d | --device)
                (( i++ ))
                DEVICE=${args[i]:?缺少参数: $a 需要一个设备，如 /dev/sdb1}
                ;;
            --device=*) DEVICE=${a#*=} ;;
            -m | --mount | --mount-point)
                (( i++ ))
                MOUNT_POINT=${args[i]:?缺少参数: $a 需要一个挂载点，如 /mnt}
                ;;
            --mount=* | --mount-point=*) MOUNT_POINT=${a#*=} ;;
            -f | --force) FORCE=1 ;;
            toggle | on | mount | off | umount | unmount | status | menu | ui | tui)
                if (( verb_seen )); then
                    die "多余的动作参数: $a（每次只接受一个动作，见 -h）"
                fi
                ACTION=$a
                verb_seen=1
                ;;
            *) die "未知参数: $a（用 -h 查看帮助）" ;;
        esac
        (( i++ ))
    done
    # 基础合法性检查
    [[ -n "$MOUNT_POINT" ]] || die "挂载点不能为空"
    [[ "$MOUNT_POINT" != / ]] || die "拒绝使用 / 作为挂载点"
}

# ==================== 主流程 ====================
parse_args "$@"
case "$ACTION" in
    auto)
        if command -v fzf >/dev/null 2>&1 && [[ -t 0 && -t 1 ]]; then
            menu
        else
            toggle
        fi
        ;;
    menu | ui | tui) menu ;;
    toggle) toggle ;;
    on | mount) mount_it ;;
    off | umount | unmount) unmount_device ;;
    status) status ;;
    *) usage ;;
esac
exit $?
